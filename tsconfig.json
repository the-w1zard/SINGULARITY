{
	"compilerOptions": {
		"lib": ["DOM", "DOM.Iterable", "ES2022", "ES2021.WeakRef"],
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"rootDir": "./src",
		"outDir": "./dist",
		"declaration": true,
		"allowJs": true,
		"strict": true,
		"isolatedModules": false,
		"skipLibCheck": true,
		"noEmit": true,
		"verbatimModuleSyntax": true,
		"types":[
			"./src/types.d.ts",
			"@the-w1zard/alias_types",
			"@the-w1zard/mq",
			"@the-w1zard/types",
			"@the-w1zard/the-cloud",
			"@the-w1zard/dx",
			"@the-w1zard/resolvers",
			"@the-w1zard/databases",
			"@the-w1zard/store",
			"node",
		],
		"ignoreDeprecations": "6.0",
		"baseUrl": ".",
		"paths": {
			"~/*": ["src/*"],
			"#electrons": ["./src/electrons/index.ts"],
			"#protons": ["./src/protons/index.ts"],
			"#master": ["./src/master_atoms/index.ts"],
			"#neutrons": ["./src/neutrons/index.ts"],
			"#sauron": ["@the-w1zard/the-cloud"],
			"#the-cloud": ["@the-w1zard/the-cloud"],
			"#tc": ["@the-w1zard/the-cloud"],
			"#STR": ["@the-w1zard/app_store"],
			"#HPR": ["@the-w1zard/prim_helpers"],
			"#PRIM": ["@the-w1zard/prims"],
		}
	},
	"include": ["**/*.ts", "**/*.tsx", "./src/t.ts" ],
	"exclude": ["node_modules", "dist", "./RKIVE/**/*"],
  }
  