{
	"compilerOptions": {
		"lib": ["DOM", "DOM.Iterable", "es2023", "ES2021.WeakRef"],
		"target": "es2023",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"rootDir": "./src",
		"outDir": "./dist",
		"declaration": true,
		"allowJs": true,
		"strict": false,
		"isolatedModules": false,
		"skipLibCheck": true,
		"noEmit": true,
		"types":[
			"@the-w1zard/dx",
			"./src/types.d.ts",
			"@the-w1zard/alias_types",
			"@the-w1zard/types",
			"node",
		],
		"ignoreDeprecations": "6.0",
		"baseUrl": ".",
		"paths": {
			"~/*": ["src/*"],
			"#dx": ["@the-w1zard/dx"],
			"#electrons": ["./src/electrons/index.ts"],
			"#protons": ["./src/protons/index.ts"],
			"#master": ["./src/master_atoms/index.ts"],
			"#neutrons": ["./src/neutrons/index.ts"],
			"#sauron": ["@the-w1zard/the-cloud"],
			"#the-cloud": ["@the-w1zard/the-cloud"],
			"#tc": ["@the-w1zard/the-cloud"],
			"#store": ["@the-w1zard/app_store"],
			"#helpers": ["@the-w1zard/helpers"],
			"#prims": ["@the-w1zard/prims"],
			"#dbs": ["@the-w1zard/databases"],
			"#mq": ["@the-w1zard/mq"],
			"#mesh": ["@the-w1zard/the-mesh"],
			"#registry": ["@the-w1zard/the-registry"],
			"#the_dark_side": ["@the-w1zard/singularity"],
			"#crdts": ["@the-w1zard/resolvers"],
		}
	},
	"include": ["**/*.ts", "**/*.tsx",  ],
	"exclude": ["node_modules", "dist", "./RKIVE/**/*", "./rspack.config.ts", "./sauron-rspack.ts"],
  }
  